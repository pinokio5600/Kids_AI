[Unit]
Description=AI Server (FastAPI + Ollama)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=simson
Group=simson
WorkingDirectory=/home/simson/ai-server
ExecStart=/home/simson/ai-server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
